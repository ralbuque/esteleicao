# Credenciais do proxy opcional, usado por baixar_logs_urnas.py com --proxy ou --hibrido.
# Copie este arquivo para .env e preencha. NUNCA versione o .env (está no .gitignore).

# URL completa do endpoint do proxy (POST {"url": "..."} e devolve o conteúdo bruto)
PROXY_URL=https://seu-host/proxy/fetch

# Autenticação Basic do proxy
N8N_BASIC_AUTH_USER=usuario
N8N_BASIC_AUTH_PASSWORD=senha
